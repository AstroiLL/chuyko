# Chuyko — настройки. Скопируй в .env (install.sh сделает это сам) и поправь.

# Токен входа на страницу (длинная случайная строка). install.sh генерирует его сам.
VOICE_TOKEN=

# Агент: OpenAI-совместимый /v1/chat/completions со стримингом.
# Hermes: включи API Server (API_SERVER_ENABLED=true в ~/.hermes/.env), ключ = API_SERVER_KEY.
# Если AGENT_KEY пуст, Chuyko сам возьмёт API_SERVER_KEY из ~/.hermes/.env.
AGENT_URL=http://127.0.0.1:8642
AGENT_KEY=
AGENT_MODEL=hermes-agent

# Где слушать. 127.0.0.1 — только через reverse proxy (рекомендуется);
# 0.0.0.0 — доступ из локальной сети.
VOICE_HOST=127.0.0.1
VOICE_PORT=7460

# Голос (синтез речи). Любой сервис с OpenAI-совместимым POST <TTS_URL>/audio/speech:
#  * silero-tts-service (бесплатно, свой сервер): TTS_URL=http://127.0.0.1:7470/v1, TTS_KEY=stts_…
#    https://github.com/AstroiLL/silero-tts-service — один на сервер или на всю сеть;
#  * OpenAI (платно): TTS_URL=https://api.openai.com/v1, TTS_KEY=sk-…, TTS_MODEL=gpt-4o-mini-tts, TTS_VOICE=alloy;
#  * пусто — адрес и токен берутся из ~/.config/silero-tts/client.env (его кладёт владелец
#    silero-tts-service, в т.ч. с другой машины в сети); нет файла — голос браузера;
#  * off — всегда голос браузера телефона.
# Если сервис синтеза недоступен, страница сама переключается на голос браузера.
TTS_URL=
TTS_KEY=
TTS_MODEL=silero
# Silero: eugene, aidar (мужские), xenia, kseniya, baya. Скорость 1.0 = обычная.
TTS_VOICE=eugene
TTS_SPEED=1.0

# Дневник разговоров в markdown (например папка в Obsidian). Пусто — выключен.
VOICE_JOURNAL_DIR=
VOICE_ASSISTANT_NAME=Чуйко

# Генерация фона (необязательно): ключ OpenRouter и модель с выводом картинок.
OPENROUTER_API_KEY=
BG_MODEL=google/gemini-3.1-flash-image
