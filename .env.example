# Chuyko — настройки. Скопируй в .env (install.sh сделает это сам) и поправь.

# Токен входа на страницу (длинная случайная строка). install.sh генерирует его сам.
VOICE_TOKEN=

# Агент: OpenAI-совместимый /v1/chat/completions со стримингом.
# Hermes: включи API Server (API_SERVER_ENABLED=true в ~/.hermes/.env), ключ = API_SERVER_KEY.
# Если AGENT_KEY пуст, Chuyko сам возьмёт API_SERVER_KEY из ~/.hermes/.env.
AGENT_URL=http://127.0.0.1:8642
AGENT_KEY=
AGENT_MODEL=hermes-agent

# Где слушать. 127.0.0.1 — только через reverse proxy (рекомендуется);
# 0.0.0.0 — доступ из локальной сети.
VOICE_HOST=127.0.0.1
VOICE_PORT=7460

# Голос Silero: aidar, baya, kseniya, xenia, eugene. Скорость 1.0 = обычная.
SILERO_VOICE=eugene
SILERO_SPEED=1.0
SILERO_MODEL=v5_5_ru

# Дневник разговоров в markdown (например папка в Obsidian). Пусто — выключен.
VOICE_JOURNAL_DIR=
VOICE_ASSISTANT_NAME=Чуйко

# Генерация фона (необязательно): ключ OpenRouter и модель с выводом картинок.
OPENROUTER_API_KEY=
BG_MODEL=google/gemini-3.1-flash-image
